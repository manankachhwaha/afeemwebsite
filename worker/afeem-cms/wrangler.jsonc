{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "afeem-cms",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },
  // The admin panel (admin/ folder) is served as static files; only the
  // API, public content feed and media paths run the Worker code.
  "assets": {
    "directory": "./admin",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/public/*", "/media/*"]
  },
  "kv_namespaces": [
    // Run `npx wrangler kv namespace create CMS_KV` and paste the id here.
    { "binding": "CMS_KV", "id": "f1b53799b5584f02b39c2099089dd643" }
  ],
  "vars": {
    // Origins allowed to POST website leads to this Worker (the public site).
    "ALLOWED_ORIGINS": "https://afeem-website.pages.dev,https://afeemspasalon.com,https://www.afeemspasalon.com,http://localhost:3000",
    "SITE_URL": "https://afeemspasalon.com"
  }
  // Secrets (never put these in this file) — set with `npx wrangler secret put <NAME>`:
  //   SESSION_SECRET  long random string, signs login cookies
  //   SETUP_KEY       one-time key needed to create the first (owner) account
  //   DEPLOY_HOOK_URL Cloudflare Pages deploy hook URL (makes "Publish" rebuild the site)
}
